# ManageEngine Analytics - copy this file to ".env" (same folder) and fill in the values. ".env" is never committed.
#
# Only the lines marked REQUIRED must live in this file: the app cannot start (or find its database) without them.
# Everything else can be set on the Admin screen once the app is running, and a value saved there OVERRIDES the line below
# (a blank value on the screen falls back to this file):
#   - Admin > Connections   ManageEngine (OAuth) and email (SMTP) details. The secrets are stored encrypted in the database with a key
#                           kept in backend\.secret (created on the first start; keep a copy of it safe, and never share it).
#   - Admin > Settings      sync times, analytics targets, security limits, names and texts, report options.

# --- Web server (REQUIRED: needed before the app can listen) ---
PORT=7780
NODE_ENV=production
# 127.0.0.1 = only this computer can open the app. Use 0.0.0.0 to share it on your network (people sign in with their own accounts).
HOST=127.0.0.1
# Only when the app sits behind a reverse proxy: how many proxies to trust (e.g. 1), so sign-in lockouts and the activity log see the real address.
# TRUST_PROXY=1

# --- MySQL (REQUIRED: the database "manageengine_analytics" is created automatically) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=manageengine_analytics
# Connections kept open to MySQL (default 10).
# DB_POOL_SIZE=10

# --- First-run administrator ---
# Only used to create the account when the users table is empty. If ADMIN_PASSWORD is left out, a random temporary password is
# printed once in the console and must be changed at the first sign-in.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=

# --- ManageEngine ServiceDesk Plus Cloud (read-only API access) ---
# These are the starting values; Admin > Connections can override every one of them without a restart.
MANAGEENGINE_ACCOUNTS_URL=https://accounts.zoho.com
MANAGEENGINE_API_DOMAIN=https://sdpondemand.manageengine.com
MANAGEENGINE_PORTAL=your-portal-name
MANAGEENGINE_CLIENT_ID=
MANAGEENGINE_CLIENT_SECRET=
MANAGEENGINE_REFRESH_TOKEN=
# Starting values for settings that can then be changed on Admin > Settings:
MANAGEENGINE_TIME_ZONE=Asia/Kolkata
# A deep sync stops once SRs are older than this date (YYYY-MM-DD).
MANAGEENGINE_SCAN_FROM=2025-10-01
# SR history: how many SRs are read at the same time (1-10, default 4).
# HISTORY_CONCURRENCY=4
# Requests allowed per minute from one address (default 900).
# RATE_LIMIT_PER_MIN=900

# --- Database backups (Admin > Backups) ---
# Backups use mysqldump; it is found automatically in the usual MySQL folders. Only set this if it is installed somewhere else.
# MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 9.5\bin\mysqldump.exe
# Backups larger than this (compressed) are not attached to the email; the email says where the file is instead.
# BACKUP_EMAIL_MAX_MB=20

# --- Outgoing email (optional): emailed backups, failure alerts and test messages ---
# For Gmail, use an "App password" (Google account > Security > 2-Step Verification > App passwords), not the normal password.
# Admin > Connections can override these without a restart.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="ManageEngine Analytics" <you@yourcompany.com>

# --- Other (rarely needed) ---
# Start the web server only: no automatic sync, history collection or backups. For running a second copy against the same database.
# NO_BACKGROUND=1
# Where the encryption key for saved passwords lives (default: backend\.secret).
# SECRET_KEY_FILE=
# Serve the screens from another folder than frontend\dist (for trying a new build).
# FRONTEND_DIST=
